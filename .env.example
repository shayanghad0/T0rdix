# ============================================
# T0rdix — Backend environment
# Copy this file to `backend/.env` and adjust.
# ============================================

# Port the API server listens on
PORT=5000

# CORS origin allowed for refresh-free dev (the Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Secret used to sign JWTs. CHANGE THIS for anything non-local.
JWT_SECRET=change-me-to-a-long-random-string

# 64 hex characters = 32 bytes key used for AES-256-GCM secret encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If omitted, a development key is derived from JWT_SECRET (dev only!).
ENCRYPTION_KEY=

# Where JSON database files live (defaults to <repo>/database)
DATABASE_DIR=

------------------------------
# Frontend (frontend/.env.local)
# ------------------------------
# VITE_API_URL=               # leave empty to use the Vite proxy (/api)

# CLI (defaults to http://localhost:5000)
# T0RDIX_SERVER=http://localhost:5000
